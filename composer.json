{
    "name": "ugm/sistem-antrian-humas",
    "type": "project",
    "description": "Sistem Antrian Humas - UGM Super App",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.0",
        "livewire/livewire": "^3.4",
        "livewire/volt": "^1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
